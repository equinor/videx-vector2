{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "oxc", "eslint", "typescript"],
  "ignorePatterns": [
    "node_modules/*",
    "dist/*",
    "docs/*",
    "*.config.*"
    ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-expressions": ["error", {"allowTernary": true, "allowShortCircuit": true}],
    "no-underscore-dangle": "off"
  },
  "overrides": [
    {
        "files": ["tests/*"],
        "plugins": ["vitest"]
    }
  ]
}